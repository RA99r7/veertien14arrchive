<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

            <title>Music Player</title>

                <style>
                        body {
                                        margin: 0;
                                                    min-height: 100vh;
                                                                display: flex;
                                                                            justify-content: center;
                                                                                        align-items: center;
                                                                                                    background: #111;
                                                                                                                font-family: Arial, sans-serif;
                        }

                                .music-player {
                                                width: 350px;
                                                            padding: 30px;
                                                                        text-align: center;
                                                                                    background: #222;
                                                                                                border-radius: 20px;
                                                                                                            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
                                }

                                        .music-player h1 {
                                                        color: white;
                                                                    margin-bottom: 10px;
                                        }

                                                .music-player p {
                                                                color: #aaa;
                                                                            margin-bottom: 25px;
                                                }

                                                        audio {
                                                                        width: 100%;
                                                        }
                                                            </style>
                                                            </head>

                                                            <body>

                                                                <div class="music-player">

                                                                        <h1>🎵 Music Player</h1>

                                                                                <p>Lagu Saya</p>

                                                                                        <audio controls>
                                                                                                    <source src="lagu17.mp3" type="audio/mpeg">
                                                                                                                Browser kamu tidak mendukung pemutar audio.
                                                                                                                        </audio>

                                                                                                                            </div>

                                                                                                                            </body>
                                                                                                                            </html>
                        }